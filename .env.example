# Per-person accounts (username + password), stored in Postgres via Prisma.
# In production this is set automatically by the Vercel Neon integration.
# For local dev, run `vercel env pull` to fetch it (or point it at your own
# local Postgres).
DATABASE_URL=

# Signs the access cookie (HMAC) that proves a login without a DB lookup on
# every request. Any long random string works. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Accounts are created with:
#   npx tsx scripts/create-user.ts <username> <name> <password>
